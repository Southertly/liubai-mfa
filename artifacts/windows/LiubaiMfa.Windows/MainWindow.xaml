<Window
    x:Class="LiubaiMfa.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:LiubaiMfa.Windows.Views"
    mc:Ignorable="d"
    Title="留白 MFA">

    <Grid
        x:Name="RootGrid"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarDragRegion"
            Height="32"
            Background="Transparent"
            AutomationProperties.Name="窗口标题栏" />

        <Grid Grid.Row="1">
            <views:AuthenticatorView
                x:Name="AuthenticatorView"
                Visibility="Collapsed" />
            <views:AddAccountView
                x:Name="AddAccountView"
                Visibility="Collapsed" />
            <views:LockView x:Name="LockView" />
        </Grid>
    </Grid>
</Window>
