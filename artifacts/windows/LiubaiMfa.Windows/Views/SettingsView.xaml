<UserControl
    x:Class="LiubaiMfa.Windows.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="Microsoft YaHei UI">

    <Grid Background="{ThemeResource MfaPageBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel
                Padding="{StaticResource MfaPagePadding}"
                Spacing="{StaticResource MfaCardSpacing}"
                MaxWidth="{StaticResource MfaSecondaryContentMaxWidth}"
                HorizontalAlignment="Stretch">
                <InfoBar
                    x:Name="StatusBar"
                    IsOpen="False"
                    IsClosable="True"
                    HorizontalAlignment="Stretch" />

                <Grid ColumnSpacing="12" Padding="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="BackButton"
                        Width="40"
                        Height="40"
                        Padding="0"
                        VerticalAlignment="Top"
                        ToolTipService.ToolTip="返回验证码"
                        AutomationProperties.Name="返回验证码"
                        Click="BackButton_Click">
                        <SymbolIcon Symbol="Back" />
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource MfaPrimaryTextBrush}" />
                        <TextBlock Text="管理安全、数据与本地行为" FontSize="13" Foreground="{ThemeResource MfaSecondaryTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="SecuritySection" Spacing="8">
                    <TextBlock Text="安全" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource MfaPrimaryTextBrush}" />
                    <Border Style="{StaticResource MfaSectionBorderStyle}" Padding="8">
                        <StackPanel>
                            <Button
                                x:Name="StartupProtectionButton"
                                Style="{StaticResource MfaSecondaryRowButtonStyle}"
                                ToolTipService.ToolTip="启动保护设置"
                                AutomationProperties.Name="启动保护设置"
                                Click="StartupProtectionButton_Click">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE72E;" FontSize="20" Foreground="{ThemeResource MfaSecurityBrush}" HorizontalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="启动保护" FontSize="15" Foreground="{ThemeResource MfaPrimaryTextBrush}" />
                                        <TextBlock Text="支持 Windows Hello 或电脑密码" FontSize="12" Foreground="{ThemeResource MfaTertiaryTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{ThemeResource MfaSecuritySoftBrush}" CornerRadius="10" Padding="10,6">
                                        <TextBlock x:Name="StartupProtectionStatusText" Text="未开启" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MfaSecurityTextBrush}" />
                                    </Border>
                                </Grid>
                            </Button>
                            <Rectangle Height="1" Fill="{ThemeResource MfaBorderBrush}" Margin="44,0,0,0" />
                            <Button
                                x:Name="LockButton"
                                Style="{StaticResource MfaSecondaryRowButtonStyle}"
                                ToolTipService.ToolTip="立即锁定全部验证码"
                                AutomationProperties.Name="立即锁定全部验证码"
                                Click="LockButton_Click">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE72E;" FontSize="20" Foreground="{ThemeResource MfaSecurityBrush}" HorizontalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="立即锁定" FontSize="15" Foreground="{ThemeResource MfaPrimaryTextBrush}" />
                                        <TextBlock Text="隐藏全部验证码" FontSize="12" Foreground="{ThemeResource MfaTertiaryTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="锁定" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MfaSecurityBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="DataSection" Spacing="8">
                    <TextBlock Text="数据" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource MfaPrimaryTextBrush}" />
                    <Border Style="{StaticResource MfaSectionBorderStyle}" Padding="8">
                        <StackPanel>
                            <Button
                                x:Name="ImportBackupButton"
                                Style="{StaticResource MfaSecondaryRowButtonStyle}"
                                ToolTipService.ToolTip="导入加密备份"
                                AutomationProperties.Name="导入加密备份"
                                Click="ImportBackupButton_Click">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE898;" FontSize="20" Foreground="{ThemeResource MfaSecurityBrush}" HorizontalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="导入加密备份" FontSize="15" Foreground="{ThemeResource MfaPrimaryTextBrush}" />
                                        <TextBlock Text="从本机文件恢复账户" FontSize="12" Foreground="{ThemeResource MfaTertiaryTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="导入" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MfaSecurityBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Rectangle Height="1" Fill="{ThemeResource MfaBorderBrush}" Margin="44,0,0,0" />
                            <Button
                                x:Name="ExportBackupButton"
                                Style="{StaticResource MfaSecondaryRowButtonStyle}"
                                ToolTipService.ToolTip="导出加密备份"
                                AutomationProperties.Name="导出加密备份"
                                Click="ExportBackupButton_Click">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE899;" FontSize="20" Foreground="{ThemeResource MfaSecurityBrush}" HorizontalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="导出加密备份" FontSize="15" Foreground="{ThemeResource MfaPrimaryTextBrush}" />
                                        <TextBlock Text="使用密码保护导出的文件" FontSize="12" Foreground="{ThemeResource MfaTertiaryTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="导出" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MfaSecurityBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="AboutSection" Spacing="8">
                    <TextBlock Text="关于" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource MfaPrimaryTextBrush}" />
                    <Border Style="{StaticResource MfaSectionBorderStyle}" Padding="16">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="3">
                                <TextBlock Text="留白 MFA" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource MfaPrimaryTextBrush}" />
                                <TextBlock Text="Windows 11 x64 · 本地优先" FontSize="13" Foreground="{ThemeResource MfaSecondaryTextBrush}" />
                            </StackPanel>
                            <Rectangle Height="1" Fill="{ThemeResource MfaBorderBrush}" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="账户、密钥与加密备份均保存在本机，不启用云同步。" FontSize="13" Foreground="{ThemeResource MfaTertiaryTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="数据目录：%LOCALAPPDATA%\Liubai MFA" FontSize="12" Foreground="{ThemeResource MfaTertiaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Text="密钥与备份均保存在本机。导出文件会经过加密，请妥善保管恢复密码。" FontSize="12" Foreground="{ThemeResource MfaTertiaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,8" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
