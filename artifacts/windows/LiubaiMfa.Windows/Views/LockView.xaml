<UserControl
    x:Class="LiubaiMfa.Windows.Views.LockView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource MfaPageBackgroundBrush}" Padding="32">
        <StackPanel Width="380" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border
                    Width="72"
                    Height="72"
                    Background="{ThemeResource MfaSecuritySoftBrush}"
                    CornerRadius="24"
                    HorizontalAlignment="Center">
                    <FontIcon
                        Glyph="&#xE73E;"
                        FontSize="34"
                        Foreground="{ThemeResource MfaSecurityTextBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="已安全锁定" />
                </Border>
                <TextBlock
                    Text="应用已锁定"
                    FontSize="26"
                    FontWeight="SemiBold"
                    TextAlignment="Center"
                    Foreground="{ThemeResource MfaPrimaryTextBrush}" />
                <TextBlock
                    x:Name="LockMessage"
                    Text="账户数据仍保存在本机，验证身份后继续。"
                    Foreground="{ThemeResource MfaTertiaryTextBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="UnlockButton"
                    Content="使用 Windows Hello 解锁"
                    MinHeight="52"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="使用 Windows Hello 解锁"
                    Click="UnlockButton_Click" />
                <Button
                    x:Name="PasswordUnlockButton"
                    Content="使用电脑密码解锁"
                    MinHeight="52"
                    HorizontalAlignment="Stretch"
                    BorderBrush="{ThemeResource MfaBorderBrush}"
                    BorderThickness="1"
                    AutomationProperties.Name="使用电脑密码解锁"
                    Click="PasswordUnlockButton_Click" />
                <TextBlock
                    Text="离开 1 分钟后自动重新锁定"
                    FontSize="12"
                    Foreground="{ThemeResource MfaTertiaryTextBrush}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="留白 MFA  ·  本地优先"
                    FontSize="12"
                    Foreground="{ThemeResource MfaTertiaryTextBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,24,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
