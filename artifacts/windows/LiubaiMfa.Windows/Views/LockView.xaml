<UserControl
    x:Class="LiubaiMfa.Windows.Views.LockView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="Microsoft YaHei UI">

    <Grid Background="{ThemeResource MfaPageBackgroundBrush}" Padding="{StaticResource MfaPagePadding}">
        <StackPanel
            MaxWidth="{StaticResource MfaSecondaryContentMaxWidth}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Spacing="14">
            <FontIcon
                Glyph="&#xE73E;"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                FontSize="36"
                Foreground="{ThemeResource MfaSecurityTextBrush}"
                HorizontalAlignment="Center"
                AutomationProperties.Name="已安全锁定" />
            <TextBlock Text="应用已锁定" FontSize="28" FontWeight="SemiBold" TextAlignment="Center" Foreground="{ThemeResource MfaPrimaryTextBrush}" />
            <TextBlock
                x:Name="LockMessage"
                Text="账户数据仍保存在本机，验证身份后继续。"
                FontSize="13"
                Foreground="{ThemeResource MfaTertiaryTextBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <Border Style="{StaticResource MfaSectionBorderStyle}" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="解锁方式" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource MfaPrimaryTextBrush}" Margin="0,0,0,8" />
                    <Button
                        x:Name="UnlockButton"
                        Style="{StaticResource MfaSecondaryRowButtonStyle}"
                        MinHeight="64"
                        AutomationProperties.Name="使用 Windows Hello 解锁"
                        Click="UnlockButton_Click">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE72E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="20" Foreground="{ThemeResource MfaSecurityBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="使用 Windows Hello 解锁" FontSize="16" Foreground="{ThemeResource MfaPrimaryTextBrush}" VerticalAlignment="Center" />
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Foreground="{ThemeResource MfaTertiaryTextBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Rectangle Height="1" Fill="{ThemeResource MfaBorderBrush}" Margin="44,0,0,0" />
                    <Button
                        x:Name="PasswordUnlockButton"
                        Style="{StaticResource MfaSecondaryRowButtonStyle}"
                        MinHeight="64"
                        AutomationProperties.Name="使用电脑密码解锁"
                        Click="PasswordUnlockButton_Click">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE77B;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="20" Foreground="{ThemeResource MfaSecurityBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="使用电脑密码解锁" FontSize="16" Foreground="{ThemeResource MfaPrimaryTextBrush}" VerticalAlignment="Center" />
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Foreground="{ThemeResource MfaTertiaryTextBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock Text="离开 1 分钟后自动重新锁定" FontSize="12" Foreground="{ThemeResource MfaTertiaryTextBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="留白 MFA  ·  本地优先" FontSize="12" Foreground="{ThemeResource MfaTertiaryTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
