<UserControl
    x:Class="LiubaiMfa.Windows.Views.AuthenticatorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:LiubaiMfa.Windows.ViewModels"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource MfaPageBackgroundBrush}" Padding="{StaticResource MfaPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="12">
            <InfoBar
                x:Name="StatusBar"
                IsOpen="False"
                IsClosable="True" />
            <Border
                Padding="24,16"
                Background="{ThemeResource MfaSurfaceBrush}"
                BorderBrush="{ThemeResource MfaBorderBrush}"
                BorderThickness="1"
                CornerRadius="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock
                            Text="验证码"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource MfaPrimaryTextBrush}" />
                        <TextBlock
                            x:Name="ProtectionStatusText"
                            Text="本机加密存储"
                            FontSize="13"
                            Foreground="{ThemeResource MfaSecondaryTextBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button
                            x:Name="SettingsButton"
                            Width="82"
                            Height="40"
                            Padding="0"
                            Content="设置"
                            FontSize="13"
                            Style="{StaticResource CompactIconButtonStyle}"
                            ToolTipService.ToolTip="设置"
                            AutomationProperties.Name="设置" />
                        <Button
                            x:Name="AddButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="添加账户"
                            AutomationProperties.Name="添加账户"
                            Click="AddButton_Click">
                            <TextBlock Text="＋" FontSize="22" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <AutoSuggestBox
            x:Name="SearchBox"
            Grid.Row="1"
            Style="{StaticResource MfaSearchBoxStyle}"
            PlaceholderText="搜索服务、账户或分组"
            QueryIcon="Find"
            AutomationProperties.Name="搜索账户"
            TextChanged="SearchBox_TextChanged" />

        <ListView
            x:Name="GroupsList"
            Grid.Row="2"
            Height="38"
            Background="Transparent"
            BorderThickness="0"
            SelectionMode="Single"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            AutomationProperties.Name="账户分组"
            SelectionChanged="GroupsList_SelectionChanged">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="32" />
                    <Setter Property="Padding" Value="12,4" />
                    <Setter Property="Margin" Value="0,0,6,0" />
                    <Setter Property="CornerRadius" Value="16" />
                    <Setter Property="Background" Value="{ThemeResource MfaMutedSurfaceBrush}" />
                    <Setter Property="Foreground" Value="{ThemeResource MfaSecondaryTextBrush}" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:GroupFilterItemViewModel">
                    <TextBlock Text="{x:Bind DisplayText}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="3">
            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14">
                <Border
                    Width="88"
                    Height="88"
                    Background="{ThemeResource MfaSecuritySoftBrush}"
                    CornerRadius="28"
                    HorizontalAlignment="Center">
                    <FontIcon
                        Glyph="&#xE72E;"
                        FontSize="36"
                        Foreground="{ThemeResource MfaSecurityTextBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="本机安全存储" />
                </Border>
                <TextBlock
                    Text="还没有账户"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource MfaPrimaryTextBrush}"
                    TextAlignment="Center" />
                <TextBlock
                    Text="添加第一个账户，验证码会安全地保存在这台设备上。"
                    FontSize="13"
                    Foreground="{ThemeResource MfaTertiaryTextBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    MaxWidth="320" />
                <Button
                    MinHeight="48"
                    Content="添加账户"
                    Padding="24,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.Name="添加账户"
                    Click="EmptyAddButton_Click" />
            </StackPanel>
            <StackPanel
                x:Name="NoResultsState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                Spacing="10">
                <TextBlock
                    Text="没有匹配的账户"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource MfaPrimaryTextBrush}"
                    TextAlignment="Center" />
                <TextBlock
                    Text="请更换关键词或选择其他分组。"
                    FontSize="13"
                    Foreground="{ThemeResource MfaTertiaryTextBrush}"
                    TextAlignment="Center" />
                <Button
                    Content="清除搜索和筛选"
                    HorizontalAlignment="Center"
                    Click="ClearFiltersButton_Click" />
            </StackPanel>
            <ListView
                x:Name="AccountsList"
                ItemContainerStyle="{StaticResource MfaAccountItemStyle}"
                SelectionMode="None"
                IsItemClickEnabled="False"
                Visibility="Collapsed"
                AutomationProperties.Name="验证码账户列表">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:AccountItemViewModel">
                        <SwipeControl IsTabStop="False">
                            <SwipeControl.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem
                                        Text="编辑"
                                        AutomationProperties.Name="编辑账户"
                                        Invoked="EditSwipeItem_Invoked" />
                                    <SwipeItem
                                        Text="查看密钥"
                                        AutomationProperties.Name="查看账户密钥"
                                        Invoked="ShowSecretSwipeItem_Invoked" />
                                    <SwipeItem
                                        Text="删除"
                                        AutomationProperties.Name="删除账户"
                                        Invoked="DeleteSwipeItem_Invoked" />
                                </SwipeItems>
                            </SwipeControl.RightItems>
                            <Border
                                Tag="{x:Bind Id}"
                                Style="{StaticResource MfaCardBorderStyle}"
                                Padding="24,20"
                                IsTabStop="True"
                                UseSystemFocusVisuals="True"
                                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                                Tapped="AccountRow_Tapped"
                                KeyDown="AccountRow_KeyDown">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="40"
                                            Height="40"
                                            Background="{x:Bind Icon.BackgroundColor}"
                                            CornerRadius="10"
                                            HighContrastAdjustment="Auto"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="服务图标">
                                            <TextBlock
                                                Text="{x:Bind Icon.FallbackText}"
                                                Foreground="{x:Bind Icon.ForegroundColor}"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel
                                            Grid.Column="1"
                                            Spacing="3"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind Issuer}"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource MfaPrimaryTextBrush}"
                                                MaxLines="1"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis" />
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Text="{x:Bind Account}"
                                                    FontSize="13"
                                                    Foreground="{ThemeResource MfaTertiaryTextBrush}"
                                                    MaxLines="1"
                                                    TextWrapping="NoWrap"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind GroupLabel}"
                                                    FontSize="11"
                                                    MaxWidth="72"
                                                    Foreground="{ThemeResource MfaSecurityBrush}"
                                                    MaxLines="1"
                                                    TextWrapping="NoWrap"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="2"
                                            MinWidth="118"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind CodeDisplay, Mode=OneWay}"
                                                FontFamily="Consolas"
                                                FontSize="30"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource MfaPrimaryTextBrush}"
                                                HorizontalAlignment="Right" />
                                            <TextBlock
                                                Text="{x:Bind RemainingLabel, Mode=OneWay}"
                                                FontSize="12"
                                                Foreground="{ThemeResource MfaTertiaryTextBrush}"
                                                HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <ProgressBar
                                            x:Name="ExpiryProgress"
                                            Height="3"
                                            Maximum="1"
                                            Value="{x:Bind ProgressValue, Mode=OneWay}"
                                            Foreground="{ThemeResource MfaProgressBrush}"
                                            Background="{ThemeResource MfaMutedSurfaceBrush}" />
                                        <ProgressBar
                                            x:Name="ExpiryAlertProgress"
                                            Height="3"
                                            Maximum="1"
                                            Value="{x:Bind ProgressValue, Mode=OneWay}"
                                            Opacity="{x:Bind ExpiryAlertOpacity, Mode=OneWay}"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Background="{ThemeResource MfaMutedSurfaceBrush}"
                                            IsHitTestVisible="False"
                                            AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                    <Border
                                        Grid.RowSpan="2"
                                        BorderBrush="{ThemeResource MfaSecurityBrush}"
                                        BorderThickness="2"
                                        CornerRadius="10"
                                        IsHitTestVisible="False"
                                        Opacity="{x:Bind RevealHintOpacity, Mode=OneWay}" />
                                    <FontIcon
                                        Grid.RowSpan="2"
                                        Glyph="&#xE73E;"
                                        FontSize="12"
                                        Margin="0,2,2,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        IsHitTestVisible="False"
                                        Opacity="{x:Bind RevealHintOpacity, Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </SwipeControl>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Row="4">
            <TextBlock
                Text="验证码每 30 秒自动更新  ·  数据仅保存在本机"
                FontSize="12"
                Foreground="{ThemeResource MfaTertiaryTextBrush}"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
