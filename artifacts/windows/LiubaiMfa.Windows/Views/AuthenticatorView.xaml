<UserControl
    x:Class="LiubaiMfa.Windows.Views.AuthenticatorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:LiubaiMfa.Windows.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="20,16,20,14" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
            <InfoBar
                x:Name="StatusBar"
                IsOpen="False"
                IsClosable="True" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="验证码"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button
                        Style="{StaticResource CompactIconButtonStyle}"
                        ToolTipService.ToolTip="导入二维码"
                        AutomationProperties.Name="导入二维码"
                        Click="ImportQrButton_Click">
                        <FontIcon Glyph="&#xE8B9;" FontSize="16" />
                    </Button>
                    <Button
                        Style="{StaticResource CompactIconButtonStyle}"
                        ToolTipService.ToolTip="立即锁定"
                        AutomationProperties.Name="立即锁定"
                        Click="LockButton_Click">
                        <FontIcon Glyph="&#xE72E;" FontSize="16" />
                    </Button>
                    <Button
                        Width="36"
                        Height="36"
                        Padding="0"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="添加账户"
                        AutomationProperties.Name="添加账户"
                        Click="AddButton_Click">
                        <FontIcon Glyph="&#xE710;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>

        <AutoSuggestBox
            x:Name="SearchBox"
            Grid.Row="1"
            PlaceholderText="搜索账户"
            QueryIcon="Find"
            AutomationProperties.Name="搜索账户"
            TextChanged="SearchBox_TextChanged" />

        <ListView
            x:Name="GroupsList"
            Grid.Row="2"
            Height="38"
            SelectionMode="Single"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            AutomationProperties.Name="账户分组"
            SelectionChanged="GroupsList_SelectionChanged">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="32" />
                    <Setter Property="Padding" Value="10,4" />
                    <Setter Property="Margin" Value="0,0,4,0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:GroupFilterItemViewModel">
                    <TextBlock Text="{x:Bind DisplayText}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="3">
            <TextBlock
                x:Name="EmptyState"
                Text="还没有账户。添加密钥或导入二维码后，验证码会显示在这里。"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            <TextBlock
                x:Name="NoResultsState"
                Text="没有匹配的账户"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
            <ListView
                x:Name="AccountsList"
                SelectionMode="None"
                IsItemClickEnabled="False"
                Visibility="Collapsed"
                AutomationProperties.Name="验证码账户列表">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:AccountItemViewModel">
                        <Border
                            MinHeight="72"
                            Padding="14,10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{x:Bind Issuer}"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock
                                        Text="{x:Bind Account}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        Text="{x:Bind GroupLabel}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" MinWidth="118">
                                    <TextBlock
                                        Text="{x:Bind FormattedCode, Mode=OneWay}"
                                        FontFamily="Consolas"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock
                                        Text="{x:Bind RemainingLabel, Mode=OneWay}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <Button
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Tag="{x:Bind Id}"
                                        ToolTipService.ToolTip="复制验证码"
                                        AutomationProperties.Name="复制验证码"
                                        Click="CopyButton_Click">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    </Button>
                                    <Button
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Tag="{x:Bind Id}"
                                        ToolTipService.ToolTip="编辑账户"
                                        AutomationProperties.Name="编辑账户"
                                        Click="EditButton_Click">
                                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                    </Button>
                                    <Button
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Tag="{x:Bind Id}"
                                        ToolTipService.ToolTip="查看密钥"
                                        AutomationProperties.Name="查看密钥"
                                        Click="ShowSecretButton_Click">
                                        <FontIcon Glyph="&#xE890;" FontSize="14" />
                                    </Button>
                                    <Button
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Tag="{x:Bind Id}"
                                        ToolTipService.ToolTip="删除账户"
                                        AutomationProperties.Name="删除账户"
                                        Click="DeleteButton_Click">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="本地加密 · Windows Hello 保护"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                VerticalAlignment="Center" />
            <Button
                Grid.Column="1"
                Content="备份与恢复"
                AutomationProperties.Name="备份与恢复">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="导入备份" Click="ImportBackupItem_Click" />
                        <MenuFlyoutItem Text="导出加密备份" Click="ExportBackupItem_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
    </Grid>
</UserControl>
