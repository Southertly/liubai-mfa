<UserControl
    x:Class="LiubaiMfa.Windows.Views.AuthenticatorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:LiubaiMfa.Windows.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource MfaPagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="10">
            <InfoBar
                x:Name="StatusBar"
                IsOpen="False"
                IsClosable="True" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock
                        Text="验证码"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock
                        x:Name="ProtectionStatusText"
                        Text="本机加密存储"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button
                        Width="44"
                        Height="44"
                        Padding="0"
                        Style="{StaticResource CompactIconButtonStyle}"
                        ToolTipService.ToolTip="设置"
                        AutomationProperties.Name="设置">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="立即锁定" AutomationProperties.Name="立即锁定" Click="LockMenuItem_Click" />
                                <MenuFlyoutItem Text="启动保护…" AutomationProperties.Name="启动保护设置" Click="SettingsMenuItem_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="导入备份…" AutomationProperties.Name="导入备份" Click="ImportBackupItem_Click" />
                                <MenuFlyoutItem
                                    x:Name="ExportBackupMenuItem"
                                    Text="导出加密备份…"
                                    AutomationProperties.Name="导出加密备份"
                                    Click="ExportBackupItem_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="AddButton"
                        Width="44"
                        Height="44"
                        Padding="0"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="添加账户"
                        AutomationProperties.Name="添加账户"
                        Click="AddButton_Click">
                        <FontIcon Glyph="&#xE710;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>

        <AutoSuggestBox
            x:Name="SearchBox"
            Grid.Row="1"
            Height="40"
            PlaceholderText="搜索服务、账户或分组"
            QueryIcon="Find"
            AutomationProperties.Name="搜索账户"
            TextChanged="SearchBox_TextChanged" />

        <ListView
            x:Name="GroupsList"
            Grid.Row="2"
            Height="38"
            SelectionMode="Single"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            AutomationProperties.Name="账户分组"
            SelectionChanged="GroupsList_SelectionChanged">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="32" />
                    <Setter Property="Padding" Value="12,4" />
                    <Setter Property="Margin" Value="0,0,6,0" />
                    <Setter Property="CornerRadius" Value="16" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:GroupFilterItemViewModel">
                    <TextBlock Text="{x:Bind DisplayText}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="3">
            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">
                <FontIcon
                    Glyph="&#xE77B;"
                    FontSize="32"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="尚未添加账户"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    TextAlignment="Center" />
                <TextBlock
                    Text="添加账户后，验证码会安全地保存在这台设备上。"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    MaxWidth="320" />
                <Button
                    MinHeight="44"
                    Content="添加账户"
                    HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.Name="添加账户"
                    Click="EmptyAddButton_Click" />
            </StackPanel>
            <StackPanel
                x:Name="NoResultsState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                Spacing="10">
                <TextBlock
                    Text="没有匹配的账户"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    TextAlignment="Center" />
                <TextBlock
                    Text="请更换关键词或选择其他分组。"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center" />
                <Button
                    Content="清除搜索和筛选"
                    HorizontalAlignment="Center"
                    Click="ClearFiltersButton_Click" />
            </StackPanel>
            <ListView
                x:Name="AccountsList"
                ItemContainerStyle="{StaticResource MfaAccountItemStyle}"
                SelectionMode="None"
                IsItemClickEnabled="False"
                Visibility="Collapsed"
                AutomationProperties.Name="验证码账户列表">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:AccountItemViewModel">
                        <SwipeControl IsTabStop="False">
                            <SwipeControl.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem
                                        Text="编辑"
                                        AutomationProperties.Name="编辑账户"
                                        Invoked="EditSwipeItem_Invoked" />
                                    <SwipeItem
                                        Text="查看密钥"
                                        AutomationProperties.Name="查看账户密钥"
                                        Invoked="ShowSecretSwipeItem_Invoked" />
                                    <SwipeItem
                                        Text="删除"
                                        AutomationProperties.Name="删除账户"
                                        Invoked="DeleteSwipeItem_Invoked" />
                                </SwipeItems>
                            </SwipeControl.RightItems>
                            <Border
                                Tag="{x:Bind Id}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                IsTabStop="True"
                                UseSystemFocusVisuals="True"
                                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                                Tapped="AccountRow_Tapped"
                                KeyDown="AccountRow_KeyDown">
                                <Grid RowSpacing="9">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="40"
                                            Height="40"
                                            Background="{x:Bind Icon.BackgroundColor}"
                                            CornerRadius="10"
                                            HighContrastAdjustment="Auto"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="服务图标">
                                            <TextBlock
                                                Text="{x:Bind Icon.FallbackText}"
                                                Foreground="{x:Bind Icon.ForegroundColor}"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel
                                            Grid.Column="1"
                                            Spacing="3"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind Issuer}"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                MaxLines="1"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis" />
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Text="{x:Bind Account}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    MaxLines="1"
                                                    TextWrapping="NoWrap"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind GroupLabel}"
                                                    FontSize="11"
                                                    MaxWidth="72"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    MaxLines="1"
                                                    TextWrapping="NoWrap"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="2"
                                            MinWidth="118"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind CodeDisplay, Mode=OneWay}"
                                                FontFamily="Consolas"
                                                FontSize="24"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                HorizontalAlignment="Right" />
                                            <TextBlock
                                                Text="{x:Bind RemainingLabel, Mode=OneWay}"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <ProgressBar
                                            x:Name="ExpiryProgress"
                                            Height="3"
                                            Maximum="1"
                                            Value="{x:Bind ProgressValue, Mode=OneWay}"
                                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                            Background="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                                        <ProgressBar
                                            x:Name="ExpiryAlertProgress"
                                            Height="3"
                                            Maximum="1"
                                            Value="{x:Bind ProgressValue, Mode=OneWay}"
                                            Opacity="{x:Bind ExpiryAlertOpacity, Mode=OneWay}"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                            IsHitTestVisible="False"
                                            AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                    <Border
                                        Grid.RowSpan="2"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="2"
                                        CornerRadius="10"
                                        IsHitTestVisible="False"
                                        Opacity="{x:Bind RevealHintOpacity, Mode=OneWay}" />
                                    <FontIcon
                                        Grid.RowSpan="2"
                                        Glyph="&#xE73E;"
                                        FontSize="12"
                                        Margin="0,2,2,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        IsHitTestVisible="False"
                                        Opacity="{x:Bind RevealHintOpacity, Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </SwipeControl>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Row="4">
            <TextBlock
                Text="验证码每 30 秒自动更新"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
