<UserControl
    x:Class="LiubaiMfa.Windows.Views.AddAccountView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyDown="AddAccountView_KeyDown">

    <ScrollViewer Background="{ThemeResource MfaPageBackgroundBrush}" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource MfaPagePadding}" Spacing="24">
            <InfoBar
                x:Name="StatusBar"
                IsClosable="True"
                IsOpen="False" />
            <Border Style="{StaticResource MfaSectionBorderStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Style="{StaticResource CompactIconButtonStyle}"
                        VerticalAlignment="Top"
                        ToolTipService.ToolTip="返回验证码列表"
                        AutomationProperties.Name="返回验证码列表"
                        Click="BackButton_Click">
                        <FontIcon Glyph="&#xE72B;" FontSize="18" />
                    </Button>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            Text="添加账户"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource MfaPrimaryTextBrush}" />
                        <TextBlock
                            Text="选择一种添加方式"
                            Foreground="{ThemeResource MfaSecondaryTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Button
                x:Name="ScreenshotScanButton"
                MinHeight="112"
                Padding="20"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Center"
                Style="{StaticResource MfaAccentButtonStyle}"
                ToolTipService.ToolTip="截图并扫描二维码"
                AutomationProperties.Name="截图并扫描二维码"
                AutomationProperties.HelpText="框选屏幕上的二维码，识别后可确认账户信息"
                Click="ScreenshotScanButton_Click">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Glyph="&#xE722;"
                        FontSize="20"
                        VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock
                            Text="截图并扫描二维码"
                            FontSize="18"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="框选屏幕上的二维码，识别后可确认账户信息"
                            Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Button>

            <StackPanel Spacing="12">
                <TextBlock
                    Text="其他方式"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Button
                    Style="{StaticResource MfaSoftRowButtonStyle}"
                    VerticalContentAlignment="Center"
                    ToolTipService.ToolTip="从图片导入"
                    AutomationProperties.Name="从图片导入"
                    AutomationProperties.HelpText="选择 PNG、JPG 或 BMP 图片"
                    Click="ImportImageButton_Click">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Glyph="&#xE8B9;"
                            FontSize="20"
                            VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock
                                Text="从图片导入"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Text="选择 PNG、JPG 或 BMP 图片"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button
                    Style="{StaticResource MfaSoftRowButtonStyle}"
                    VerticalContentAlignment="Center"
                    ToolTipService.ToolTip="手动输入"
                    AutomationProperties.Name="手动输入"
                    AutomationProperties.HelpText="输入服务、账户和密钥"
                    Click="ManualEntryButton_Click">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Glyph="&#xE70F;"
                            FontSize="20"
                            VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock
                                Text="手动输入"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Text="输入服务、账户和密钥"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
